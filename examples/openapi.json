{
  "openapi": "3.1.0",
  "info": {
    "title": "Geospatial File Measurement API",
    "description": "Upload KML or zipped Shapefiles and retrieve feature geometry and horizontal metric measurements.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/files/": {
      "post": {
        "tags": [
          "files"
        ],
        "summary": "Upload File",
        "description": "Process synchronously; per-feature failures are included in the results.",
        "operationId": "upload_file_api_files__post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_api_files__post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileInfo"
                }
              }
            }
          },
          "400": {
            "description": "Empty or invalid upload"
          },
          "413": {
            "description": "Resource limit exceeded"
          },
          "415": {
            "description": "Unsupported file extension"
          },
          "422": {
            "description": "Invalid dataset, CRS, or archive"
          }
        }
      }
    },
    "/api/files/{file_id}/": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "File Info",
        "operationId": "file_info_api_files__file_id___get",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileInfo"
                }
              }
            }
          },
          "404": {
            "description": "Unknown file"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{file_id}/measurements/": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "File Measurements",
        "operationId": "file_measurements_api_files__file_id__measurements__get",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "File Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementPage"
                }
              }
            }
          },
          "404": {
            "description": "Unknown file"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_file_api_files__post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "KML or zipped Shapefile"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file_api_files__post"
      },
      "FeatureResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "feature_id": {
            "type": "string",
            "title": "Feature Id"
          },
          "geometry_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry Type"
          },
          "geometry": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          },
          "crs": {
            "type": "string",
            "title": "Crs"
          },
          "properties": {
            "additionalProperties": true,
            "type": "object",
            "title": "Properties"
          },
          "measurement": {
            "$ref": "#/components/schemas/Measurement"
          }
        },
        "type": "object",
        "required": [
          "index",
          "feature_id",
          "geometry_type",
          "geometry",
          "crs",
          "properties",
          "measurement"
        ],
        "title": "FeatureResult"
      },
      "FileInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "format": {
            "type": "string",
            "enum": [
              "KML",
              "SHAPEFILE"
            ],
            "title": "Format"
          },
          "feature_count": {
            "type": "integer",
            "title": "Feature Count"
          },
          "crs": {
            "type": "string",
            "title": "Crs"
          },
          "crs_wkt": {
            "type": "string",
            "title": "Crs Wkt"
          },
          "status": {
            "type": "string",
            "const": "COMPLETED",
            "title": "Status"
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Uploaded At"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes"
          },
          "measured_feature_count": {
            "type": "integer",
            "title": "Measured Feature Count"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "format",
          "feature_count",
          "crs",
          "crs_wkt",
          "status",
          "uploaded_at",
          "size_bytes",
          "measured_feature_count"
        ],
        "title": "FileInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Measurement": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "MEASURED",
              "NO_MEASUREMENT",
              "EMPTY_GEOMETRY",
              "UNSUPPORTED",
              "INVALID_GEOMETRY",
              "MEASUREMENT_ERROR"
            ],
            "title": "Status"
          },
          "area_m2": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Area M2"
          },
          "length_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length M"
          },
          "measurement_crs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurement Crs"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Measurement"
      },
      "MeasurementPage": {
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid",
            "title": "File Id"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/FeatureResult"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "total",
          "offset",
          "limit",
          "features"
        ],
        "title": "MeasurementPage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
